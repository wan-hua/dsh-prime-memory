# ================= 基础 =================
XY_DB_PATH=./data/app.db
XY_HOST=127.0.0.1
XY_PORT=8000
# 设置后所有 /api 请求需带 X-Admin-Token 头；页面可用 ?token=xxx 打开
XY_ADMIN_TOKEN=
# 没配 XY_ADMIN_TOKEN 时，管理接口默认只允许本机访问。
# 除非已经用反代做了鉴权，否则不要改成 1。
XY_ADMIN_ALLOW_REMOTE=0
XY_LOG_LEVEL=INFO
# 日志文件（自动轮转：单文件 10MB，保留 5 份）。留空则只输出到控制台，
# 适合交给 systemd / docker 收集
XY_LOG_FILE=./logs/server.log
XY_LOG_MAX_BYTES=10485760
XY_LOG_BACKUP_COUNT=5

# ================= 登录态保活（防掉登录） =================
# IM accessToken 进程内缓存（秒）。重连越频繁越有用，0 = 不缓存。
XY_IM_TOKEN_TTL=14400
# _m_h5_tk 主动刷新间隔（秒），在 min~max 之间随机，避免固定节奏。0 = 关闭主动刷新。
XY_MH5TK_REFRESH_MIN=5400
XY_MH5TK_REFRESH_MAX=9000
# Cookie 保活间隔（秒）。调用 passport hasLogin.do 给登录态续期，0 = 关闭。
XY_SESSION_KEEPALIVE_INTERVAL=1800

# ================= 发货行为 =================
XY_DELIVERY_COOLDOWN=600
XY_SEND_RETRY=2
# 1 = 只打日志不真发（也不会真的去建 2018K 卡密）。首次上线建议先开
XY_DRY_RUN=0
# 订单轮询间隔（秒）。0 = 关闭。
# 闲鱼的消息推送会因为断线/风控漏消息，订单状态是「拉」得到的，更可靠。
# 这是「一直没有任何推送」时的兜底节奏；平时发包一到就会提前叫醒轮询，
# 所以实际发货延迟通常在几秒内。想更稳（或更保守）就调这个数。
XY_ORDER_POLL_INTERVAL=30
# 收到推送后多久允许再补查一次订单（秒），防止消息多时把接口打爆。0 = 关闭加速。
XY_ORDER_HINT_POLL_GAP=5
# 一次轮询里同时处理几单。1 = 串行。并发越高，多人同时下单时越快。
XY_ORDER_POLL_CONCURRENCY=3
# 同一个订单的详情缓存多久（秒）：补商品 ID 和取金额共用一次查询。0 = 不缓存。
XY_ORDER_CACHE_TTL=30
# 1 = 把收到的每条原始消息负载写进日志。排查「为什么没发货」时打开，
# 平时关掉（消息多的时候会刷屏）
XY_DEBUG_PAYLOAD=0

# 会话列表轮询间隔（秒）。0 = 关闭。
# 私信正文不一定会走 WebSocket 推送（线上实测经常只推「某会话有新消息」的
# 未读标记、不给正文），所以另外按这个节奏拉一次最近会话，
# 把每个会话的最后一条消息当新消息处理（按服务端 messageId 去重）。
XY_MESSAGE_POLL_INTERVAL=20
XY_MESSAGE_POLL_LIMIT=20
# 发现会话有新消息时，往回补拉多少条历史（1~50）。
# 买家连发两条时只看「最后一条」会漏，所以按会话补一段。
XY_MESSAGE_HISTORY_LIMIT=20
# 每轮最多给几个会话补拉历史（每次都算一趟 WS 往返）。0 = 永只看最后一条。
XY_MESSAGE_HISTORY_CONVERSATIONS=5
# 旧会话保护（秒）：会话最后一条消息超过这个时长就整段忽略；默认 1 天。
# 设为 0 会关闭保护（不推荐，重启/接入旧号时可能批量回复历史消息）。
XY_MESSAGE_STALE_SECONDS=86400
# WebSocket 心跳间隔（秒）与 /reg→ackDiff 间隔（秒）。一般不用改。
XY_HEARTBEAT_INTERVAL=10
XY_REGISTER_GAP=1
# ackDiff 同步位点重发间隔（秒）。增量推送是服务端对 ackDiff 的响应，
# 只发一次基本收不到新消息；0 = 只发一次（不推荐）。
XY_SYNC_POLL_INTERVAL=30

# ================= 自动回复（商品 / 关键词） =================
# 总开关：1 = 命中规则自动回私信，0 = 全关（只发货，不搭理）
XY_AUTO_REPLY=1
# 回复前等几秒，避免「秒回」显得像机器人。0 = 立刻回
XY_AUTO_REPLY_DELAY=1

# ================= 金额与 2018K 卡密 =================
# 订单金额单位：auto / yuan / fen。auto 会把 >=1000 的纯整数当「分」
XY_ORDER_AMOUNT_UNIT=auto
# 单笔订单金额上限（元），超过不发货。强烈建议填，防标错价被刷。0 = 不限
XY_MAX_ORDER_CNY=200
# 卡密天数在「发货规则」里设置：固定天数，或「每 1 元 = N 天」。
# 金额只用于换算天数，不再有任何 USD / 汇率概念。

# ================= 上游：2018K 卡密验证平台 =================
# 推荐在后台「设置」页填写；面板保存的值写在 SQLite，优先于这里的初始值。
# OpenId：2018K 后台「个人中心」可见，32 位十六进制。
# 它同时是 AES 密钥（不是登录凭据），创建卡密时用它加密 info。
XY_2018K_OPENID=你的32位OpenId
# 实例列表：名称=32位softwareId。多个用逗号 / 分号 / 换行分隔。
# 名称只用于后台下拉框显示；规则里按 softwareId 绑定。
XY_2018K_INSTANCES=Miracles=实例ID1,MiraclesX64=实例ID2
# 公开 API 地址，一般不用改
XY_2018K_API_BASE=https://api.2018k.cn/v3
# 可选：2018K 后台账号，仅用于「发货失败时删除已建卡密」。
# 不填也能正常发货，但失败时只能到后台手动删卡（卡密 ID 会写进订单详情）。
XY_2018K_ADMIN_BASE=https://admin.2018k.cn
XY_2018K_ADMIN_USERNAME=
XY_2018K_ADMIN_PASSWORD=

# ================= MiniDailyReward 扫码入池二维码 =================
# 同一台服务器上的控制台，默认只监听本机 8790。
XY_MINIDAILY_API_BASE=http://127.0.0.1:8790
# 令牌在 /opt/miniworld/webui-token.txt；只放本机 .env，不要提交到仓库。
XY_MINIDAILY_TOKEN=

# ================= 订单自动化（求小红花 / 提醒收货 / 评价） =================
# 面板「设置 → 订单自动化」里也有开关；这里只是初始值。默认全部关闭。
XY_SOCIAL_AUTO_FLOWER=0
XY_SOCIAL_AUTO_REMIND=0
XY_SOCIAL_AUTO_RATE=0
# 买家送小红花时自动领取；默认开启
XY_SOCIAL_AUTO_RECEIVE_FLOWER=1
XY_SOCIAL_RATE_CONTENT=很好，合作愉快！
# 开启时刻由面板保存时自动写入；手动批处理测试可用来限制时间范围
XY_SOCIAL_SINCE=
